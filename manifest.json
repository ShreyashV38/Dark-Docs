{
  "manifest_version": 3,
  "name": "DarkSpace - Dark Mode for Google Docs, Sheets & Classroom",
  "short_name": "DarkSpace",
  "version": "2.0.0",
  "description": "High-precision Dark Mode suite for Google Docs, Sheets, Classroom, Slides, Forms, Drawings, Scholar, Translate, and Contacts.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/document/*",
        "*://docs.google.com/spreadsheets/*",
        "*://docs.google.com/presentation/*",
        "*://docs.google.com/forms/*",
        "*://docs.google.com/drawings/*"
      ],
      "js": ["canvas-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://docs.google.com/document/*",
        "*://docs.google.com/spreadsheets/*",
        "*://docs.google.com/presentation/*",
        "*://docs.google.com/forms/*",
        "*://docs.google.com/drawings/*",
        "*://classroom.google.com/*",
        "*://scholar.google.com/*",
        "*://translate.google.com/*",
        "*://contacts.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["darkmode.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "canvas-hook.js",
        "darkmode.css"
      ],
      "matches": [
        "*://docs.google.com/*",
        "*://classroom.google.com/*",
        "*://scholar.google.com/*",
        "*://translate.google.com/*",
        "*://contacts.google.com/*"
      ]
    }
  ]
}
